{
  "version": 2,
  "builds": [
    {
      "src": "api/*.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/designation_finder",
      "dest": "api/designation_finder.py"
    },
    {
      "src": "/api/accounts",
      "dest": "api/accounts.py"
    },
    {
      "src": "/api/mango_ecrop_data",
      "dest": "api/mango_ecrop_data.py"
    },
    {
      "src": "/mangodataprovider",
      "dest": "/mangodataprovider.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}